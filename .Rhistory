# --- Task 4: Veri Analizi (2003 Doğumlu Cihan İçin) ---
# 1. Paket ve Veri Yükleme
library(dslabs)
install.packages("dslabs")
print(head(na_per_column, 8))
# 6. NA Değerlerini Değiştirme
# Sayısal: 2003 + 21 = 2024
# Karakter: Cihan_21
new_data <- polls_us_election_2016
print(anyNA(new_data))
#| echo: true
#| message: false
# 1. Paket Kontrolü ve Yükleme (Eğer yoksa yükler)
if (!require("dslabs")) install.packages("dslabs")
library(dslabs)
# 2. Veriyi Sahneye Çağırma (Hatanın çözümü burası!)
data("polls_us_election_2016")
# 3. Kişisel Değişkenler (Cihan, 2003)
my_first <- "Cihan"
my_birth_year <- 2003
# 4. k Hesabı (k=21 çıkar)
k <- (nchar(my_first) + my_birth_year) %% 15 + 8
# 5. Orijinal Veri Çıktısı (k=21 tek olduğu için tail)
if (k %% 2 == 0) {
print(head(polls_us_election_2016, k))
} else {
print(tail(polls_us_election_2016, k))
}
# 6. NA Analizi
total_na <- sum(is.na(polls_us_election_2016))
na_per_col <- sort(colSums(is.na(polls_us_election_2016)), decreasing = TRUE)
print(head(na_per_col, 8))
# 7. NA Değerlerini Değiştirme (Yeni Obje)
new_data <- polls_us_election_2016
for(i in 1:ncol(new_data)) {
if(is.numeric(new_data[[i]])) {
new_data[[i]][is.na(new_data[[i]])] <- my_birth_year + k # 2024
} else {
new_data[[i]] <- as.character(new_data[[i]])
new_data[[i]][is.na(new_data[[i]])] <- paste0(my_first, "_", k) # Cihan_21
}
}
# 8. Final Kontroller
if (k %% 2 == 0) {
print(head(new_data, k))
} else {
print(tail(new_data, k))
}
cat("Kalan NA Sayısı:", sum(is.na(new_data)), "\n")
print(anyNA(new_data))
#| echo: true
#| message: false
