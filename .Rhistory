# 1. Gerekli paket kontrolü ve yükleme
if (!require("dslabs")) install.packages("dslabs", repos = "http://cran.us.r-project.org")
library(dslabs)
data("polls_us_election_2016")
# 2. Değişkenler ve k hesabı (Cihan, 2003 için k = 21)
my_first <- "Cihan"
my_birth_year <- 2003
k <- (nchar(my_first) + my_birth_year) %% 15 + 8
# 3. Orijinal veriden k satır göster (k=21 tek olduğu için tail)
print(if (k %% 2 == 0) head(polls_us_election_2016, k) else tail(polls_us_election_2016, k))
# 4. NA Analizi: Toplam ve Sütun bazlı (ilk 8)
sum(is.na(polls_us_election_2016))
head(sort(colSums(is.na(polls_us_election_2016)), decreasing = TRUE), 8)
# 5. NA Değerlerini Değiştirme (Yeni objeye: new_data)
new_data <- polls_us_election_2016
for(i in 1:ncol(new_data)) {
if(is.numeric(new_data[[i]])) {
new_data[[i]][is.na(new_data[[i]])] <- my_birth_year + k # 2024
} else {
new_data[[i]] <- as.character(new_data[[i]])
new_data[[i]][is.na(new_data[[i]])] <- paste0(my_first, "_", k) # Cihan_21
}
}
# 6. Yeni veri çıktıları ve final kontrol
print(if (k %% 2 == 0) head(new_data, k) else tail(new_data, k))
sum(is.na(new_data))
anyNA(new_data) # FALSE dönmeli
library(dslabs)
data("polls_us_election_2016")
# Değişkenler
my_first <- "Cihan"
my_birth_year <- 2003
k <- (nchar(my_first) + my_birth_year) %% 15 + 8
# Orijinal veri gösterimi (k=21 olduğu için tail çalışacak)
if(k %% 2 == 0) head(polls_us_election_2016, k) else tail(polls_us_election_2016, k)
# NA Analizi
sum(is.na(polls_us_election_2016))
sort(colSums(is.na(polls_us_election_2016)), decreasing = TRUE)[1:8]
# NA Değiştirme
new_data <- polls_us_election_2016
for(i in 1:ncol(new_data)) {
if(is.numeric(new_data[[i]])) {
new_data[[i]][is.na(new_data[[i]])] <- my_birth_year + k
} else {
new_data[[i]] <- as.character(new_data[[i]])
new_data[[i]][is.na(new_data[[i]])] <- paste0(my_first, "_", k)
}
}
# Yeni veri çıktıları
if(k %% 2 == 0) head(new_data, k) else tail(new_data, k)
sum(is.na(new_data))
anyNA(new_data)
